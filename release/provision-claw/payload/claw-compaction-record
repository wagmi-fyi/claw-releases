#!/usr/bin/env python3
"""claw-compaction-record -- write down that a session compacted, and say nothing.

Installed machine-wide and run by the harness's after-compaction hook, beside
claw-bus-join, so every compaction on the claw leaves a record without anybody
remembering to. The hook passes the session's own facts as JSON on stdin.

WHY A RECORD AND NOT A SENTENCE. Measured 2026-09-26: this event's stdout does
not reach the model at all, and the one event whose stdout does is SessionStart
with the matcher `compact`, whose printed line sits in the context and loses to
the turn's own prompt. So a hook cannot make a session do anything. What it can
do is leave a fact on disk for the continuity rail, which sends the session the
turn that re-invokes the skill the run is governed by. This program is that fact
and nothing else.

THIS PROGRAM NEVER FAILS A SESSION, AND NEVER SPEAKS TO ONE. A record that cannot
be written is dropped and the exit status stays 0. Nothing is printed on stdout
on any path, because this event's stdout is ignored and a program that printed
here would be writing for a reader that does not exist.

WHERE IT WRITES. The account's own state directory, the one the continuity rail
reads: $XDG_STATE_HOME/commonclaw/continuity, or ~/.local/state under it. One
JSON line appended per compaction, carrying the session id, the transcript path
and the time. The rail consumes a record when it has acted on it and drops one it
has held too long, so this file does not grow without bound.

THE APPEND IS ONE WRITE OF ONE LINE. Several sessions on one account compact
independently and the rail rewrites the file as it consumes records. A single
write to a file opened for append is what keeps two of those from interleaving
half a line each.
"""
import datetime
import json
import os
import sys

RECORDS = "compactions.jsonl"


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "commonclaw", "continuity")


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    session = str(payload.get("session_id") or "")
    if not session:
        # NO GUESS AT THE SESSION. The rail matches a record to a handle by this
        # id, so a record without one names nothing and would sit in the file
        # until it aged out.
        return 0
    line = json.dumps({
        "session": session,
        "transcript": str(payload.get("transcript_path") or ""),
        "cwd": str(payload.get("cwd") or ""),
        "trigger": str(payload.get("trigger") or ""),
        "at": datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat(),
    }, sort_keys=True) + "\n"
    path = os.path.join(state_dir(), RECORDS)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(line)
    except OSError:
        # The rail's own --check names this file, so an operator has somewhere to
        # look. A hook that failed a session over it would be the worse failure.
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
