#!/usr/bin/env python3
"""email-gatekeeper adapter -- AgentMail.

THE ADAPTER CONTRACT, WHICH EVERY ADAPTER HERE ANSWERS AND NONE MAY WIDEN:

  probe        {}                                  -> {"provider","ready","reason"}
  make-inbox   {"username","domain","display_name"} -> {"inbox_id","address"}
  thread       {"inbox_id","thread_id"}             -> {"thread_id","subject","messages":[...]}
  message      {"inbox_id","message_id"}            -> one message object
  send         {"inbox_id","to","cc","subject","text","in_reply_to","thread_id"}
                                                    -> {"message_id","thread_id"}
  listen       {"inbox_id"}                         -> one JSON line per inbound mail
                                                       until killed, and one per frame
                                                       it did not act on
  list-since   {"inbox_id","after"}                 -> {"messages":[...]}, each in the
                                                       shape listen prints, oldest first

  JSON on stdin, one JSON object on stdout. Exit 0 for an answer, 2 for usage,
  3 for a transport that changed underneath. A failure prints
  {"error": "..."} and exits 3, so the core never has to guess.

  make-inbox with an empty username is usage. It prints {"error": "..."},
  exits 2, and calls the provider for nothing, because a provider given no
  name picks one. No error, reason or usage line an adapter prints carries a
  backtick.

THE KEY COMES FROM THE ENVIRONMENT AND GOES NOWHERE ELSE. `EMAIL_PROVIDER_KEY`
is read once here. /proc/PID/cmdline is world-readable and this claw is
deliberately multi-user, so the key is never an argument, never printed, and
never written to a log. The WebSocket URL carries the key as a query parameter,
which is this provider's own authentication for that transport, and that URL is
composed inside this file and passed to nothing that records it.

WHY THERE IS A WEBSOCKET CLIENT IN HERE. The push channel is RFC 6455 and this
claw's programs are Python standard library only, which has no WebSocket client.
So a minimal one lives here, in the adapter, which is exactly where a provider's
transport belongs. The core never sees it.

THE SEND ACT MAPS TO TWO CALLS. AgentMail's send endpoint carries no in_reply_to
field: a threaded send is a separate endpoint keyed by the message being
answered. One act at the seam, two calls at the provider. That is what an
adapter is for.

WHAT WAS READ, AND WHEN. The endpoints, the event strings and the subscribe
frame below were read from AgentMail's published documentation on 2026-09-04.
An API that has moved since shows up as a 404 or an unexpected shape, and both
exit 3 rather than being smoothed over.

THE PUSH CHANNEL IS KEPT BUSY. The provider closes a connection that has
carried nothing from our side for 10 minutes. On the hub, 712 connections
between 2026-09-14 and 2026-09-17 each closed at exactly 600 seconds. So listen
sends a ping frame every PING_SECS. The read timeout is the loop's beat, so a
ping is at most READ_SECS late.

MAIL THAT ARRIVED WHILE NOBODY LISTENED IS LISTED. The push channel delivers
only what arrives after the subscribe frame and replays nothing. list-since
reads the provider's list endpoint from a time the core saved, oldest first,
every page, and only mail the provider labelled received. Each message comes
back in the shape listen prints. It carries the preview and never the text.

A REFUSAL CARRIES THE PROVIDER'S OWN WORDS. The same status can mean several
things here: a create answered 403 for a name that already exists, and the
status alone told a person nothing. So the reason takes the string fields the
provider puts in a JSON error body, and only those named in SAID_FIELDS, each
cut to SAID_LIMIT characters. Never the whole body and never a header. A field
that holds the key is dropped whole.

AN INBOX THAT ALREADY EXISTS IS ADOPTED. A create refused as already existing
lists this organisation's inboxes and answers with the one at the address that
was asked for. A second inbox is never made. When the organisation has none at
that address, another organisation holds the name, and the refusal says so. The
refusal's name and code, and the listing's shape, were measured against the
provider on 2026-09-14; the documentation says nothing of either.
"""

import base64
import datetime
import json
import os
import socket
import ssl
import struct
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

API = os.environ.get("AGENTMAIL_API", "https://api.agentmail.to")
WS = os.environ.get("AGENTMAIL_WS", "wss://ws.agentmail.to/v0")
KEY_ENV = "EMAIL_PROVIDER_KEY"
UA = "commonclaw-email-gatekeeper"
# The fields of an error body a reason may carry, in the order it carries them.
SAID_FIELDS = ("error", "message", "detail", "name", "code")
SAID_LIMIT = 200
# The domain the provider gives an inbox made with none named.
DEFAULT_DOMAIN = "agentmail.to"
# A listing that pages further than this is not an organisation's inboxes.
MAX_PAGES = 100
# The push channel's keepalive and its read beat, in seconds. The provider's
# idle close is at 600, so a ping due at 300 goes out by 370 at the latest. A
# control shortens both. Nothing on a claw sets them.
PING_SECS = float(os.environ.get("AGENTMAIL_PING_SECS", "300"))
READ_SECS = float(os.environ.get("AGENTMAIL_READ_SECS", "70"))
# One page of the list endpoint. A control shortens it to prove the paging.
LIST_LIMIT = int(os.environ.get("AGENTMAIL_LIST_LIMIT", "100"))
# A listed mail with one of these labels is not routed. The push channel leaves
# these out unless a subscriber asks for them, and listen does not ask.
UNROUTED_LABELS = ("spam", "blocked", "unauthenticated", "trash")


def die(reason, code=3):
    print(json.dumps({"error": reason}))
    sys.exit(code)


def key():
    k = os.environ.get(KEY_ENV, "").strip()
    if not k:
        die("no %s in this adapter's environment" % KEY_ENV)
    return k


def provider_said(exc):
    """The provider's own words on an error status, as {field: text}.

    Read from a JSON error body, and only the fields SAID_FIELDS names. Each is
    one line cut to SAID_LIMIT characters. A body that is not a JSON object
    gives nothing, and so does a field holding the key.
    """
    try:
        body = json.loads(exc.read(65536).decode("utf-8", "replace"))
    except Exception:
        return {}
    if not isinstance(body, dict):
        return {}
    k = os.environ.get(KEY_ENV, "").strip()
    said = {}
    for f in SAID_FIELDS:
        v = body.get(f)
        if not isinstance(v, str):
            continue
        v = " ".join(v.split())[:SAID_LIMIT]
        if v and not (k and k in v):
            # A backtick becomes a single quote. These words reach a reason a
            # reader may quote into a shell string, where a backtick runs a
            # command. Written as chr(96) so this file carries none in a string.
            said[f] = v.replace(chr(96), "'")
    return said


def said_suffix(said):
    """What a reason appends after the status: ': f=text; ...', or nothing."""
    words = "; ".join("%s=%s" % (f, said[f]) for f in SAID_FIELDS if f in said)
    return (": " + words) if words else ""


class Refused(Exception):
    """An error status from the provider: the call, the status, the words."""

    def __init__(self, method, path, status, said):
        Exception.__init__(self)
        self.method, self.path, self.status, self.said = method, path, status, said

    def already_exists(self):
        return (self.said.get("code") == "already_exists"
                or self.said.get("name") == "AlreadyExistsError")

    def reason(self):
        # The status and the endpoint, then the provider's words. Never the
        # key, never a header, never the body of a message.
        return "%s %s answered %s%s" % (self.method, self.path, self.status,
                                        said_suffix(self.said))


def api(method, path, body=None):
    url = API.rstrip("/") + path
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", "Bearer " + key())
    req.add_header("User-Agent", UA)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        raise Refused(method, path, exc.code, provider_said(exc))
    except (urllib.error.URLError, OSError, ssl.SSLError) as exc:
        die("%s %s could not be reached: %s" % (method, path, exc))
    if not raw.strip():
        return {}
    try:
        return json.loads(raw)
    except ValueError:
        die("%s %s answered something that is not JSON" % (method, path))


def norm_message(m):
    """The provider's message, in the seam's shape. The core reads only this."""
    return {
        "message_id": m.get("message_id", ""),
        "thread_id": m.get("thread_id", ""),
        "from": m.get("from", ""),
        "to": m.get("to", []),
        "cc": m.get("cc", []),
        "subject": m.get("subject", ""),
        "date": m.get("timestamp") or m.get("created_at", ""),
        "text": m.get("text", ""),
        "in_reply_to": m.get("in_reply_to", ""),
    }


def as_list(v):
    if not v:
        return []
    return v if isinstance(v, list) else [v]


# ------------------------------------------------------------------- the verbs
def v_probe(_req):
    """Is this adapter here and does its key open the account?

    A probe that only checked for a key would answer ready on a revoked one.
    """
    k = os.environ.get(KEY_ENV, "").strip()
    if not k:
        return {"provider": "agentmail", "ready": False,
                "reason": "no %s in this adapter's environment" % KEY_ENV}
    url = API.rstrip("/") + "/v0/inboxes?limit=1"
    req = urllib.request.Request(url, method="GET")
    req.add_header("Authorization", "Bearer " + k)
    req.add_header("User-Agent", UA)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            resp.read(1)
        return {"provider": "agentmail", "ready": True, "reason": "the account answered"}
    except urllib.error.HTTPError as exc:
        return {"provider": "agentmail", "ready": False,
                "reason": "the account answered %s%s"
                          % (exc.code, said_suffix(provider_said(exc)))}
    except (urllib.error.URLError, OSError, ssl.SSLError) as exc:
        return {"provider": "agentmail", "ready": False,
                "reason": "the provider could not be reached: %s" % exc}


def v_make_inbox(req):
    username = (req.get("username") or "").strip()
    if not username:
        # The provider picks a name when it is given none. Refused before any
        # call, so a caller that went round the command makes nothing.
        die("make-inbox needs a username, so nothing was asked of the provider", 2)
    body = {"username": username}
    if req.get("domain"):
        body["domain"] = req["domain"]
    if req.get("display_name"):
        body["display_name"] = req["display_name"]
    try:
        out = api("POST", "/v0/inboxes", body)
    except Refused as exc:
        if not exc.already_exists():
            raise
        address = "%s@%s" % (username, req.get("domain") or DEFAULT_DOMAIN)
        out = find_inbox(address)
        if not out:
            die("%s, and this organisation has no inbox at %s, so another organisation "
                "holds that name" % (exc.reason(), address))
    return {"inbox_id": out.get("inbox_id", ""), "address": out.get("email", "")}


def find_inbox(address):
    """This organisation's inbox at an address, or None. Reads every page."""
    token, seen = "", set()
    for _ in range(MAX_PAGES):
        q = {"limit": 100}
        if token:
            q["page_token"] = token
        page = api("GET", "/v0/inboxes?" + urllib.parse.urlencode(q))
        for i in page.get("inboxes") or []:
            if str(i.get("email", "")).lower() == address.lower():
                return i
        token = page.get("next_page_token") or ""
        if not token or token in seen:
            return None
        seen.add(token)
    return None


def v_thread(req):
    inbox = urllib.parse.quote(req.get("inbox_id", ""), safe="")
    tid = urllib.parse.quote(req.get("thread_id", ""), safe="")
    out = api("GET", "/v0/inboxes/%s/threads/%s" % (inbox, tid))
    return {
        "thread_id": out.get("thread_id", ""),
        "subject": out.get("subject", ""),
        "messages": [norm_message(m) for m in out.get("messages", [])],
    }


def v_message(req):
    inbox = urllib.parse.quote(req.get("inbox_id", ""), safe="")
    mid = urllib.parse.quote(req.get("message_id", ""), safe="")
    return norm_message(api("GET", "/v0/inboxes/%s/messages/%s" % (inbox, mid)))


def v_list_since(req):
    """Received mail since a time, oldest first, in the shape listen prints.

    AN EMPTY after IS USAGE. A list with no lower bound is the whole inbox, and
    the core would route every mail ever received.
    """
    inbox = req.get("inbox_id", "")
    after = (req.get("after") or "").strip()
    if not inbox or not after:
        die("list-since needs an inbox_id and an after time, so nothing was listed", 2)
    when = provider_time(after)
    if not when:
        die("list-since was given an after time it cannot read: %s" % word_or_len(after), 2)
    path = "/v0/inboxes/%s/messages" % urllib.parse.quote(inbox, safe="")
    token, seen, out = "", set(), []
    for _ in range(MAX_PAGES):
        # NO labels FILTER IN THE QUERY. The provider refused this call with 400
        # on the hub on 2026-09-17 and named no field, so the query carries only
        # what the refusal cannot be about. The received filter is applied below.
        q = {"after": when, "ascending": "true", "limit": LIST_LIMIT}
        if token:
            q["page_token"] = token
        page = api("GET", path + "?" + urllib.parse.urlencode(q))
        for m in page.get("messages") or []:
            labels = m.get("labels") or []
            if "received" not in labels or any(l in labels for l in UNROUTED_LABELS):
                continue
            out.append(as_event(inbox, m))
        token = page.get("next_page_token") or ""
        if not token:
            return {"messages": out}
        if token in seen:
            die("the list endpoint gave the same page token twice")
        seen.add(token)
    die("the list endpoint paged past %d pages" % MAX_PAGES)


def provider_time(text):
    """A time in the form the provider's list endpoint takes, or "".

    UTC, milliseconds, and a Z. The core saves its own times with +00:00, and
    a strict datetime check refuses that offset.
    """
    try:
        t = datetime.datetime.fromisoformat(str(text or "").strip().replace("Z", "+00:00"))
    except ValueError:
        return ""
    if t.tzinfo is None:
        t = t.replace(tzinfo=datetime.timezone.utc)
    t = t.astimezone(datetime.timezone.utc)
    return t.strftime("%Y-%m-%dT%H:%M:%S.") + "%03dZ" % (t.microsecond // 1000)


def word_or_len(text):
    return "%d characters" % len(str(text))


def as_event(inbox, m):
    """One mail in the shape listen prints. The preview, never the text."""
    return {
        "event": "received",
        "inbox_id": inbox,
        "message_id": m.get("message_id", ""),
        "thread_id": m.get("thread_id", ""),
        "from": m.get("from", ""),
        "to": m.get("to", []),
        "subject": m.get("subject", ""),
        "date": m.get("timestamp") or m.get("created_at", ""),
        # The provider's own preview. The gatekeeper truncates it and
        # composes nothing.
        "preview": m.get("preview", ""),
    }


def v_send(req):
    inbox = urllib.parse.quote(req.get("inbox_id", ""), safe="")
    body = {
        "to": as_list(req.get("to")),
        "subject": req.get("subject", ""),
        "text": req.get("text", ""),
    }
    if req.get("cc"):
        body["cc"] = as_list(req["cc"])
    if req.get("in_reply_to"):
        # The threaded half of the act. The endpoint is keyed by the message
        # being answered, and it carries no subject: the provider takes it from
        # the thread.
        body.pop("subject", None)
        mid = urllib.parse.quote(req["in_reply_to"], safe="")
        out = api("POST", "/v0/inboxes/%s/messages/%s/reply" % (inbox, mid), body)
    else:
        out = api("POST", "/v0/inboxes/%s/messages/send" % inbox, body)
    return {"message_id": out.get("message_id", ""), "thread_id": out.get("thread_id", "")}


# ------------------------------------------------------ the push channel
#
# A minimal RFC 6455 client. Messages in, whole, however many frames carried
# them. Text frames out, ping answered with a pong that echoes it, close
# honoured. Nothing else, because nothing else is needed to read an event
# stream, and every line of transport here is a line that can be wrong.
class WebSocket:
    def __init__(self, url, timeout=READ_SECS):
        parts = urllib.parse.urlsplit(url)
        host = parts.hostname
        port = parts.port or (443 if parts.scheme == "wss" else 80)
        path = parts.path or "/"
        if parts.query:
            path += "?" + parts.query
        raw = socket.create_connection((host, port), timeout=30)
        if parts.scheme == "wss":
            ctx = ssl.create_default_context()
            raw = ctx.wrap_socket(raw, server_hostname=host)
        raw.settimeout(timeout)
        self.sock = raw
        self.buf = b""
        nonce = base64.b64encode(os.urandom(16)).decode()
        handshake = (
            "GET %s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
            "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\nUser-Agent: %s\r\n\r\n"
            % (path, host, nonce, UA)
        )
        raw.sendall(handshake.encode("ascii"))
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = raw.recv(4096)
            if not chunk:
                raise OSError("the provider closed the connection during the handshake")
            head += chunk
        status = head.split(b"\r\n", 1)[0].decode("latin-1")
        if "101" not in status:
            raise OSError("the push channel refused the upgrade: %s" % status)
        self.buf = head.split(b"\r\n\r\n", 1)[1]

        # A MESSAGE IN PROGRESS survives a read timeout. The opcode of its
        # first frame and the payloads so far.
        self.msg_op = None
        self.msg_parts = []

    @staticmethod
    def _parse(buf):
        """One whole frame from the front of buf, or None while it is partial.

        Nothing is consumed until the whole frame is there. A read timeout
        halfway through a frame used to lose its header, and every byte after
        it was then read as a wrong frame.
        """
        if len(buf) < 2:
            return None
        b0, b1 = buf[0], buf[1]
        n = b1 & 0x7F
        at = 2
        if n == 126:
            if len(buf) < 4:
                return None
            n = struct.unpack(">H", buf[2:4])[0]
            at = 4
        elif n == 127:
            if len(buf) < 10:
                return None
            n = struct.unpack(">Q", buf[2:10])[0]
            at = 10
        mask = b""
        if b1 & 0x80:
            if len(buf) < at + 4:
                return None
            mask = buf[at:at + 4]
            at += 4
        if len(buf) < at + n:
            return None
        data = buf[at:at + n]
        if mask:
            data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
        return bool(b0 & 0x80), b0 & 0x0F, data, at + n

    def recv_frame(self):
        """(fin, opcode, payload). A timeout leaves the buffer as it was."""
        while True:
            frame = self._parse(self.buf)
            if frame:
                fin, op, data, used = frame
                self.buf = self.buf[used:]
                return fin, op, data
            chunk = self.sock.recv(65536)
            if not chunk:
                raise OSError("the push channel closed")
            self.buf += chunk

    def send_text(self, text):
        self.send_frame(0x1, text.encode("utf-8"))

    def send_ping(self):
        self.send_frame(0x9, b"")

    def send_frame(self, opcode, payload):
        header = bytearray([0x80 | opcode])
        mask = os.urandom(4)
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header.append(0x80 | 126)
            header += struct.pack(">H", n)
        else:
            header.append(0x80 | 127)
            header += struct.pack(">Q", n)
        header += mask
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(bytes(header) + masked)

    def recv_message(self):
        """One whole message as (opcode, payload), or None after a control frame.

        A MESSAGE MAY COME IN PIECES. RFC 6455 lets a sender split one message
        into a first frame and continuation frames, and the provider's gateway
        splits a large one. A received-mail event carries the whole message and
        its thread, which is the large kind. This client used to read the first
        piece alone and drop the rest, so the mail never reached the service.
        """
        while True:
            fin, op, data = self.recv_frame()
            if op == 0x8:
                raise OSError("the provider sent a close frame%s" % close_words(data))
            if op == 0x9:
                # A pong carries the ping's own payload back.
                self.send_frame(0xA, data)
                return None
            if op == 0xA:
                return None
            if op == 0x0:
                if self.msg_op is None:
                    return (0x0, data)
                self.msg_parts.append(data)
            else:
                self.msg_op, self.msg_parts = op, [data]
            if fin:
                whole = (self.msg_op, b"".join(self.msg_parts))
                self.msg_op, self.msg_parts = None, []
                return whole

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def close_words(data):
    """The code and the reason a close frame carries, or nothing.

    The reason is the provider's own text, one line, cut to SAID_LIMIT, with a
    backtick made a single quote. A reason that holds the key is dropped.
    """
    if len(data) < 2:
        return ""
    code = struct.unpack(">H", data[:2])[0]
    why = " ".join(data[2:].decode("utf-8", "replace").split())[:SAID_LIMIT]
    k = os.environ.get(KEY_ENV, "").strip()
    if k and k in why:
        why = ""
    why = why.replace(chr(96), "'")
    return " with code %d%s" % (code, (": " + why) if why else "")


def v_listen(req):
    """Stream inbound mail until something breaks. Never returns normally.

    Only `message.received` is subscribed. Spam, blocked and unauthenticated
    arrive as their own event types and are excluded from a subscription unless
    a subscriber asks for them and holds the matching label permission. Not
    asking is this claw's decision and it is also the provider's default.
    """
    inbox = req.get("inbox_id", "")
    if not inbox:
        die("listen was given no inbox_id")
    url = WS + ("&" if "?" in WS else "?") + urllib.parse.urlencode({"api_key": key()})
    try:
        ws = WebSocket(url)
    except (OSError, ssl.SSLError) as exc:
        die("the push channel could not be opened: %s" % exc)
    try:
        ws.send_text(json.dumps({
            "type": "subscribe",
            "event_types": ["message.received"],
            "inbox_ids": [inbox],
        }))
        last_ping = time.monotonic()
        while True:
            # THE KEEPALIVE. Checked on every pass, so a busy channel and a
            # quiet one both carry a frame from our side before the idle close.
            if time.monotonic() - last_ping >= PING_SECS:
                try:
                    ws.send_ping()
                except (OSError, ssl.SSLError) as exc:
                    die("the push channel dropped: %s" % exc)
                last_ping = time.monotonic()
            try:
                got = ws.recv_message()
            except socket.timeout:
                # A quiet channel is normal. A read timeout is not a drop, and
                # treating it as one would reconnect this claw all day.
                continue
            except (OSError, ssl.SSLError) as exc:
                die("the push channel dropped: %s" % exc)
            if got is None:
                continue
            op, payload = got
            if op != 0x1:
                emit(unrecognised("binary" if op == 0x2 else "continuation", None, len(payload)))
                continue
            try:
                msg = json.loads(payload.decode("utf-8", "replace"))
            except ValueError:
                emit(unrecognised("not-json", None, len(payload)))
                continue
            if not isinstance(msg, dict):
                emit(unrecognised("not-an-object", None, len(payload)))
                continue
            kind = msg.get("type")
            if kind == "subscribed":
                named = msg.get("inbox_ids")
                emit({"event": "listening", "inbox_id": inbox,
                      "inbox_confirmed": (inbox in named) if isinstance(named, list) else None})
                continue
            if kind == "error":
                die("the push channel answered an error: %s" % (word(msg.get("name")) or "unnamed"))
            m = msg.get("message")
            if (kind == "event" and msg.get("event_type") == "message.received"
                    and isinstance(m, dict)):
                emit(as_event(inbox, m))
                continue
            emit(unrecognised(kind, msg, len(payload)))
    finally:
        ws.close()


# A word a frame names about itself: letters, digits and . _ - only, and short.
# Anything else is a value, and a value never leaves this adapter in a report.
WORD_CHARS = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-")


def word(v):
    if not isinstance(v, str) or not v or len(v) > 40 or not set(v) <= WORD_CHARS:
        return ""
    return v


def unrecognised(kind, msg, size):
    """A frame this adapter did not act on, described without its content.

    NOTHING IS DROPPED SILENTLY. On 2026-09-17 a mail reached the provider
    while this adapter was connected, and nothing on the claw said a frame had
    come and been passed over. The report names the frame's type word, its
    event type word, its top-level key names and its size. A key name that is
    not a plain word is counted and not named, because a provider that keyed a
    frame by an address would otherwise put that address in the journal.
    """
    keys, odd = [], 0
    if isinstance(msg, dict):
        for k in msg:
            if word(k):
                keys.append(k)
            else:
                odd += 1
    report = {"event": "unrecognised",
              "frame_type": word(kind) if isinstance(msg, dict) else kind,
              "keys": sorted(keys)[:30], "size": size}
    if isinstance(msg, dict):
        report["event_type"] = word(msg.get("event_type"))
        report["message_is"] = type(msg.get("message")).__name__
    if odd:
        report["unnamed_keys"] = odd
    return report


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


VERBS = {
    "probe": v_probe,
    "make-inbox": v_make_inbox,
    "thread": v_thread,
    "message": v_message,
    "send": v_send,
    "listen": v_listen,
    "list-since": v_list_since,
}


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in VERBS:
        sys.stderr.write("usage: agentmail <%s>, JSON on stdin\n" % "|".join(sorted(VERBS)))
        return 2
    verb = sys.argv[1]
    raw = sys.stdin.readline() if verb == "listen" else sys.stdin.read()
    try:
        req = json.loads(raw or "{}")
    except ValueError:
        die("stdin was not JSON", 2)
    try:
        out = VERBS[verb](req)
    except Refused as exc:
        die(exc.reason())
    if out is not None:
        emit(out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
