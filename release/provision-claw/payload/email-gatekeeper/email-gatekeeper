    "ADAPTER": "agentmail",
    "ADAPTER_DIR": "",
    "STATE_DIR": "/srv/connections/email-gatekeeper/state",
    "LOG_DIR": "/srv/connections/email-gatekeeper/log",
    "SOCKET": "/run/email-gatekeeper/sock",
    "SOCKET_GROUP": "claw-members",
    "BUS_CLI": "/opt/commonclaw/bin/bus",
