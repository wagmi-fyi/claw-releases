ENVFILE = os.environ.get("EMAIL_GATEKEEPER_ENV", "/etc/commonclaw/email-gatekeeper.env")
CRED_FILE = "/etc/commonclaw/credentials/op-service-account.cred"
CRED_NAME = "op-service-account"

