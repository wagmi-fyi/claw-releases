NO_INBOX_REASON = ("routes.json names no inbox yet: a person makes it with "
                   "'email inbox create --username NAME'")


def stderr_is_journal():
    """Is this process's stderr the journal systemd gave it?

    systemd writes the device and the inode of that stream into JOURNAL_STREAM.
    A process that inherited the variable and then had its stderr sent to a file
    reads false here, which is the answer a control wants.
    """
    want = os.environ.get("JOURNAL_STREAM", "")
    if not want:
        return False
    try:
        st = os.fstat(2)
    except Exception:
        return False
    return want == "%d:%d" % (st.st_dev, st.st_ino)


def log(level, msg):
    """Everything this service says goes to the journal. Never to a bus.

    A rail that recorded its own trouble into an inbox would raise unread mail,
    which would raise a nudge, which would raise more mail.

    ONE LINE PER EVENT. Under systemd the journal already holds what this
    process writes to stderr, and the syslog call puts the same words there a
    second time. The syslog line is the one to keep: it carries the level as the
    journal's own priority. The stderr copy is written when stderr is something
    else, which is how a person running the service by hand and a control
    reading its log file both see it.
    """
    try:
        syslog.syslog(
            {"err": syslog.LOG_ERR, "warn": syslog.LOG_WARNING}.get(level, syslog.LOG_INFO),
            msg,
        )
    except Exception:
        pass
    if stderr_is_journal():
        return
    sys.stderr.write("%s %s\n" % (level, msg))
    sys.stderr.flush()


class Settings:
    def __init__(self):
        self.values = dict(DEFAULTS)
        self.origin = {k: "shipped default" for k in DEFAULTS}
        if os.path.isfile(CONF):
            for line in read_lines(CONF):
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                k = k.strip()
                if k in self.values:
                    self.values[k] = v.strip().strip('"').strip("'")
                    self.origin[k] = CONF
        for k in list(self.values):
            env = os.environ.get("EMAIL_GATEKEEPER_" + k)
            if env is not None:
                self.values[k] = env
                self.origin[k] = "environment"

    def __getattr__(self, name):
        key = name.upper()
        if key in self.values:
            return self.values[key]
        raise AttributeError(name)

    def adapter_dir(self):
        if self.values["ADAPTER_DIR"]:
            return self.values["ADAPTER_DIR"]
        return os.path.join(os.path.dirname(os.path.realpath(__file__)),
                            "email-gatekeeper-adapters")

    def adapter_path(self):
        return os.path.join(self.adapter_dir(), self.values["ADAPTER"])

    def enabled(self):
        return self.values["ENABLED"].strip().lower() in ("yes", "true", "1", "on")

    def reconnect_bounds(self):
        lo = max(1, to_int(self.values["RECONNECT_MIN_SECS"], 1))
        hi = max(lo, to_int(self.values["RECONNECT_MAX_SECS"], 60))
        return lo, hi


def to_int(v, fallback):
    try:
        return int(str(v).strip())
    except (TypeError, ValueError):
        return fallback


def read_lines(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.readlines()
    except OSError:
        return []


# ---------------------------------------------------------------------- the key
#
# THE VALUE NEVER TOUCHES DISK AND NEVER TOUCHES A COMMAND LINE. /proc/PID/cmdline
# is world-readable and this claw is deliberately multi-user, so the key reaches
# an adapter through that adapter's environment and reaches nothing else at all.
def resolve_key():
    """The provider key, from a reference, through the machine credential.

    Two token paths, the same two the memory check uses: the credentials
    directory systemd populates for this unit, and root decrypting the claw's own
    credential by hand. Both read a file at the moment of use. Returns the key or
    raises with a reason that names no value.
    """
    # THE ONE VALUE A CONTROL MAY HAND IN, and it is the resolved key rather than
    # a token: a control that had to reach a real vault would need a real secret
    # to prove a mechanism that has nothing to do with one. A systemd unit starts
    # with a clean environment, so nothing on a claw sets this.
    #
    # The broker token is NOT offered this way. That is the credential a slip
    # prints, and the seam a control uses for it is a path.
    if os.environ.get(KEY_ENV):
        return os.environ[KEY_ENV]

    ref = ""
    for line in read_lines(ENVFILE):
        line = line.strip()
        if line.startswith("COMMONCLAW_EMAIL_PROVIDER_KEY=op://"):
            ref = line.split("=", 1)[1].strip()
            break
    if not ref:
        raise RuntimeError("%s carries no COMMONCLAW_EMAIL_PROVIDER_KEY op:// reference" % ENVFILE)

    # THE TOKEN IS READ FROM A FILE AT THE MOMENT OF USE, never taken from this
    # process's environment. Under the unit systemd has already decrypted it into
    # the credentials directory; run by hand as root there is no unit, and root
    # decrypts the claw's own credential itself.
    #
    # An inherited variable is not a source. A member running this by hand under
    # sudo would otherwise resolve with whatever token their own session carried,
    # which is a different plane's credential answering for this one. The
    # credentials directory is the seam a control points at a scratch file: it is
    # a path, so it is safe to print and safe to put in a command line.
    tok = ""
    cdir = os.environ.get("CREDENTIALS_DIRECTORY", "")
    cpath = os.path.join(cdir, CRED_NAME) if cdir else ""
    if cpath and os.access(cpath, os.R_OK):
        with open(cpath, "r", encoding="utf-8") as fh:
            tok = fh.read().strip()
    elif os.access(CRED_FILE, os.R_OK):
        try:
            tok = subprocess.run(
                ["systemd-creds", "decrypt", "--name=" + CRED_NAME, CRED_FILE, "-"],
                capture_output=True, text=True, timeout=30,
            ).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            tok = ""
    if not tok:
        raise RuntimeError(
            "no service-account token reached this process, so %s could not be resolved" % ENVFILE)

    env = dict(os.environ)
    env["OP_SERVICE_ACCOUNT_TOKEN"] = tok
    try:
        p = subprocess.run(["op", "read", ref], capture_output=True, text=True,
                           env=env, timeout=60)
    except OSError:
        raise RuntimeError("the manager CLI is not installed, so %s cannot be resolved" % ENVFILE)
    value = (p.stdout or "").strip()
    if p.returncode != 0 or not value:
        # The manager's own stderr can quote an item name. It never quotes a
        # value, but this service does not pass it on either way.
        raise RuntimeError("the manager returned no value for the reference in %s" % ENVFILE)
    return value


# ------------------------------------------------------------------- the state
#
# TWO FILES, TWO OWNERS, TWO LIFETIMES.
#
# routes.json is a ruling about this machine. It is seeded once at install and no
# apply rewrites it. A person edits it, or the `email route` and `email self`
# verbs do. THE FILE IS THE RECORD AND THIS PROCESS SERVES IT: the table is
# re-read whenever the bytes on disk have moved on, so an edit made by hand
# reaches the running service within one event. A process that answered its own
# start-up copy forever would make the file a record that lies.
#
# threads.jsonl is this service's own memory. Append-only, because a process
# killed mid-write must not lose the map that routes a reply back to the desk
# that started the conversation. Last line for a thread id wins, and the file is
# compacted at start.
#
# position.json is this service's memory too, and it is written below, beside
# the class that reads it.

# THE KEY ORDER routes.json IS WRITTEN IN, which is the order the shipped
# template carries. A write goes through one function that imposes it, so a
# table the command has written is byte-comparable with the template it was
# seeded from. Sorting the keys instead reorders the file on its first write
# and leaves every later diff carrying that move.
ROUTES_KEY_ORDER = ("_comment", "self", "default", "domains", "addresses")
SELF_KEY_ORDER = ("address", "display_name", "inbox_id", "runbook")

# The stamp a table has before it has ever been read. No stat produces it, so
# the first refresh always loads.
NEVER_READ = object()

# THE MODE OF EVERY FILE THIS SERVICE WRITES, set here and not left to the
# umask. The installer seeds routes.json at 0640. A write through the command
# made a new file under systemd's default umask of 0022 and renamed it over the seed,
# so the table came back 0644, and threads.jsonl the same way. Measured on
# staging on 2026-09-12. The directories above are 0750, so nobody outside the
# group gained a read. The file still has to match what the release seeded. The
# socket's mode is set in this program for the same reason.
STATE_FILE_MODE = 0o640


def open_new_private(path):
    """A fresh file at STATE_FILE_MODE, whatever umask this process runs under.

    fchmod after the open, because the mode os.open is given passes through
    the umask and could come out tighter than the seed.
    """
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, STATE_FILE_MODE)
    os.fchmod(fd, STATE_FILE_MODE)
    return os.fdopen(fd, "w", encoding="utf-8")


def in_key_order(obj, order):
    """One mapping, rebuilt in a named order, with anything unnamed after it.

    A key the order does not name is somebody's addition to this machine's
    table. It keeps its place at the end rather than being dropped.
    """
    out = {}
    for k in order:
        if k in obj:
            out[k] = obj[k]
    for k in obj:
        if k not in out:
            out[k] = obj[k]
    return out


class State:
    def __init__(self, state_dir):
        self.dir = state_dir
        self.routes_path = os.path.join(state_dir, "routes.json")
        self.threads_path = os.path.join(state_dir, "threads.jsonl")
        self.lock = threading.Lock()
        self.routes = {}
        self.routes_stamp = NEVER_READ
        self.refresh_routes()
        self.threads = {}
        self.learned = {}

    def load_routes(self):
        try:
            with open(self.routes_path, "r", encoding="utf-8") as fh:
                r = json.load(fh)
        except (OSError, ValueError):
            r = {}
        if not isinstance(r, dict):
            r = {}
        r.setdefault("self", {})
        # FILLED KEY BY KEY, so a table written before a field existed reads
        # back with that field present and empty. Defaulting the whole block
        # only reaches a table that has no `self` at all, which is a table
        # nobody has ever run `email inbox create` against.
        for k in ("address", "display_name", "inbox_id", "runbook"):
            r["self"].setdefault(k, "")
        r.setdefault("default", "")
        r.setdefault("domains", {})
        r.setdefault("addresses", {})
        return r

    def stamp(self):
        """What the file on disk looks like from outside, without reading it.

        The inode is in it because a hand edit through an editor replaces the
        file rather than writing into it, and the size is in it because a mtime
        can repeat on a fast enough write.
        """
        try:
            st = os.stat(self.routes_path)
        except OSError:
            return None
        return (st.st_mtime_ns, st.st_size, st.st_ino)

    def refresh_routes(self):
        """Re-read the table when the bytes on disk have moved on.

        THE STAMP IS TAKEN BEFORE THE READ. A write that lands between the two
        leaves the old stamp recorded, so the next call reads again. Taking it
        afterwards would record a change this process never loaded.

        A write of our own is not stamped, so the next event re-reads what we
        just wrote. That costs one read and closes the window where a hand edit
        arrives between the write and the stat.
        """
        seen = self.stamp()
        if self.routes_stamp is not NEVER_READ and seen == self.routes_stamp:
            return False
        with self.lock:
            self.routes = self.load_routes()
            self.routes_stamp = seen
        return True

    def save_routes(self):
        """Written whole, through a temp file in the same directory.

        `mv` from elsewhere would drop the group under /srv, so the temp file is
        made here and replaced in place.

        THE ONE WRITER. Every change to the table comes through here, in the
        template's key order, so a file this service has written and the file
        the installer seeds differ only where a value differs.
        """
        out = in_key_order(self.routes, ROUTES_KEY_ORDER)
        if isinstance(out.get("self"), dict):
            out["self"] = in_key_order(out["self"], SELF_KEY_ORDER)
        tmp = self.routes_path + ".new"
        with open_new_private(tmp) as fh:
            json.dump(out, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, self.routes_path)

    def load_threads(self):
        """The map, last line for a thread winning, with the time each was learned.

        The time comes from the same line as the handle, so a thread that moved
        to another desk carries the time it moved.
        """
        seen = {}
        learned = {}
        for line in read_lines(self.threads_path):
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            tid = rec.get("thread_id")
            handle = rec.get("handle")
            if tid and handle:
                seen[tid] = handle
                if rec.get("ts"):
                    learned[tid] = rec["ts"]
                else:
                    learned.pop(tid, None)
        self.threads = seen
        self.learned = learned
        return seen

    def compact_threads(self):
        """One line per thread, written once at start. Bounded growth, no loss.

        EACH THREAD KEEPS THE TIME IT WAS LEARNED. Compaction wrote the time of
        the compaction onto every line, so each restart replaced when a thread
        was learned with when the service last started. A restart is due
        whenever the program's bytes change. Found on staging on 2026-09-12. A
        line that carried no time is written with none, and no time is invented
        for it.

        THE COMPACTION STAMPS ITSELF ONCE, on a first line that names no thread,
        so load_threads passes over it.
        """
        self.load_threads()
        tmp = self.threads_path + ".new"
        with open_new_private(tmp) as fh:
            fh.write(json.dumps({"compacted_at": iso_now(),
                                 "threads": len(self.threads)}) + "\n")
            for tid, handle in sorted(self.threads.items()):
                rec = {"thread_id": tid, "handle": handle}
                if tid in self.learned:
                    rec["ts"] = self.learned[tid]
                fh.write(json.dumps(rec) + "\n")
        os.replace(tmp, self.threads_path)

    def remember_thread(self, thread_id, handle):
        if not thread_id or not handle:
            return
        with self.lock:
            ts = iso_now()
            self.threads[thread_id] = handle
            self.learned[thread_id] = ts
            append_json(self.threads_path,
                        {"thread_id": thread_id, "handle": handle, "ts": ts})

    def route(self, sender, thread_id):
        """Which handles a mail reaches, and why.

        THE THREAD MAP IS READ BEFORE THE TABLE. A reply belongs to the desk that
        started the conversation, whatever the sender's domain maps to. That is
        the whole reason the map exists.
        """
        if thread_id and thread_id in self.threads:
            return [self.threads[thread_id]], "thread"
        addr = (sender or "").strip().lower()
        if "<" in addr and ">" in addr:
            addr = addr[addr.rfind("<") + 1:addr.rfind(">")].strip()
        entry = self.routes["addresses"].get(addr)
        if isinstance(entry, dict) and entry.get("handles"):
            return list(entry["handles"]), "address"
        domain = addr.rpartition("@")[2]
        if domain and self.routes["domains"].get(domain):
            return list(self.routes["domains"][domain]), "domain"
        if self.routes.get("default"):
            return [self.routes["default"]], "default"
        return [], "none"


# ---------------------------------------------------------------- the position
#
# position.json is where the catch-up starts. It holds the inbox it belongs to,
# the provider's time of the newest mail routed, and the ids of the last
# ROUTED_KEEP mails routed. No subject, no sender, no preview and no text: an
# id and a time are all a catch-up needs, and mail rests at the provider.
#
# A MAIL IS ROUTED ONCE. The push channel and the catch-up can both hand the
# service the same mail, and a catch-up runs on every connect. The id list is
# what refuses the second copy, across reconnects and across restarts.
#
# THE FIRST START ROUTES NOTHING OLD. With no position for this inbox, the
# position is the moment the listener first starts, so mail that arrived before
# this service ever ran reaches no session. A position that cannot be read is
# treated the same way, because the alternative is routing the whole inbox.
ROUTED_KEEP = 500


def parse_time(text):
    """A provider time or one of ours, as an aware datetime, or None."""
    try:
        t = datetime.datetime.fromisoformat(str(text or "").strip().replace("Z", "+00:00"))
    except ValueError:
        return None
    return t if t.tzinfo else t.replace(tzinfo=datetime.timezone.utc)


class Position:
    def __init__(self, state_dir):
        self.path = os.path.join(state_dir, "position.json")
        self.inbox_id = ""
        self.after = ""
        self.message_id = ""
        self.routed = []
        self.load()

    def load(self):
        try:
            with open(self.path, "r", encoding="utf-8") as fh:
                rec = json.load(fh)
        except OSError:
            return
        except ValueError:
            log("warn", "%s cannot be read, so the catch-up starts from now" % self.path)
            return
        if not isinstance(rec, dict) or parse_time(rec.get("after")) is None:
            log("warn", "%s holds no time, so the catch-up starts from now" % self.path)
            return
        self.inbox_id = str(rec.get("inbox_id") or "")
        self.after = str(rec.get("after") or "")
        self.message_id = str(rec.get("message_id") or "")
        self.routed = [str(i) for i in (rec.get("routed") or []) if i][-ROUTED_KEEP:]

    def save(self):
        """Written whole, through a temp file beside it, at STATE_FILE_MODE."""
        tmp = self.path + ".new"
        try:
            with open_new_private(tmp) as fh:
                json.dump({"inbox_id": self.inbox_id, "after": self.after,
                           "message_id": self.message_id, "routed": self.routed},
                          fh, indent=2)
                fh.write("\n")
            os.replace(tmp, self.path)
        except OSError as exc:
            log("err", "could not write %s, so a restart may route a mail twice: %s"
                % (self.path, exc))

    def start(self, inbox):
        """The position for this inbox, made from now when there is none."""
        if self.inbox_id == inbox and self.after:
            return False
        self.inbox_id = inbox
        self.after = iso_now()
        self.message_id = ""
        self.routed = []
        self.save()
        return True

    def seen(self, message_id):
        return bool(message_id) and message_id in self.routed

    def record(self, message_id, when):
        """One routed mail. The time moves only forward."""
        if message_id:
            self.routed.append(message_id)
            del self.routed[:-ROUTED_KEEP]
        t = parse_time(when)
        if t is not None and (parse_time(self.after) is None or t > parse_time(self.after)):
            self.after = str(when)
            self.message_id = message_id or ""
        self.save()


def clean(text, limit=300):
    """A reason as one printable line: no backtick, cut to length.

    An adapter's words and an exception's words reach status and the journal,
    and a reader quotes either into a shell string.
    """
    return " ".join(str(text or "").split()).replace(chr(96), "'")[:limit]


# How many passed-over frames reach the journal in one hour.
PASSED_OVER_PER_HOUR = 10

# A word a report names: letters, digits and . _ - only, and short. The same
# rule the adapters apply, applied again here.
WORD_CHARS = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-")


def word(v):
    if not isinstance(v, str) or not v or len(v) > 40 or not set(v) <= WORD_CHARS:
        return ""
    return v


# What a reason starts with when it is an adapter's own words. The journal and
# `reason` keep it. `health` and `last_stop` do not.
ADAPTER_SAID = "the adapter said: "


def sentences(text, capital):
    """A reason as sentences for `health`.

    A reason joins its clauses with a colon, as in "the push channel dropped:
    the provider sent a close frame". Each colon followed by "the " starts a new
    sentence. Every sentence but the first starts with a capital, and the first
    does when capital is true. A first word that is not plain lowercase letters,
    such as a file name, keeps its case.
    """
    parts = clean(text).rstrip(".").split(": the ")
    out = []
    for i, p in enumerate([parts[0]] + ["the " + q for q in parts[1:]]):
        first = p.split(" ", 1)[0]
        if (i or capital) and first.isalpha() and first.islower():
            p = p[0].upper() + p[1:]
        out.append(p.rstrip(".") + ".")
    return " ".join(out)


def times(n):
    return "1 time" if n == 1 else "%d times" % n


def iso_now():
    return time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime())


def append_json(path, obj):
    """One line appended. A file made here is made at STATE_FILE_MODE.

    An append leaves an existing file's mode as it finds it.
    """
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, STATE_FILE_MODE)
    with os.fdopen(fd, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(obj, sort_keys=True) + "\n")


# ----------------------------------------------------------------- the adapter
def run_adapter(settings, key, verb, payload, timeout=90):
    """One adapter call. JSON in, one JSON object out.

    The key rides the environment. Not argv, because /proc/PID/cmdline is
    world-readable here.

    A REFUSAL CARRIES ITS CAUSE UNDER `error`. That is the seam's failure key,
    which is what both shipped adapters write and what an adapter written for
    any other provider writes. `reason` is a different thing: a field of the
    probe's answer, which succeeds. Reading `reason` on a failure gave a member
    running `email inbox create` the words "no reason given" while the same
    refusal told root, through --check, that the account answered 403.
    """
    path = settings.adapter_path()
    if not (os.path.isfile(path) and os.access(path, os.X_OK)):
        raise RuntimeError("no executable adapter for '%s' at %s" % (settings.adapter, path))
    env = dict(os.environ)
    if key:
        env[KEY_ENV] = key
    p = subprocess.run([path, verb], input=json.dumps(payload), capture_output=True,
                       text=True, env=env, timeout=timeout)
    out = (p.stdout or "").strip()
    if not out:
        raise RuntimeError("the %s adapter answered nothing to '%s': %s"
                           % (settings.adapter, verb, (p.stderr or "").strip()[:200]))
    try:
        obj = json.loads(out.splitlines()[-1])
    except ValueError:
        raise RuntimeError("the %s adapter answered '%s' with something that is not JSON"
                           % (settings.adapter, verb))
    if p.returncode not in (0,):
        raise RuntimeError("the %s adapter failed '%s': %s"
                           % (settings.adapter, verb, obj.get("error", "no reason given")))
    return obj


# ------------------------------------------------------------------- the bus
def bus_send(settings, to_handle, subject, body, ref):
    """One bus message. The full text is never on the bus.

    NO BACKTICKS AND NO SECRETS IN A BODY. Everybody on this machine reads every
    inbox: that is the trust plane, and the standing law rides with it.
    """
    cli = settings.bus_cli
    if not os.access(cli, os.X_OK):
        raise RuntimeError("no bus CLI at %s" % cli)
    env = dict(os.environ)
    if settings.bus_dir:
        env["SESSION_BUS_DIR"] = settings.bus_dir
    argv = [cli, "send", settings.bus_handle, to_handle, subject, body]
    if ref:
        argv += ["--ref", ref]
    p = subprocess.run(argv, capture_output=True, text=True, env=env, timeout=30)
    if p.returncode != 0:
        raise RuntimeError("bus send to %s failed: %s" % (to_handle, (p.stderr or "").strip()[:200]))
    return (p.stdout or "").strip()


def one_line(text, limit=240):
    """The provider's own preview, on one line, cut to length.

    NEVER GENERATED. This service does not read a mail for meaning, so the
    summary it puts on the bus is the provider's field and nothing else. A model
    call here would put judgement in the plumbing.
    """
    s = " ".join((text or "").split())
    return s[:limit]


# ------------------------------------------------------------------ the runtime
class Gatekeeper:
    def __init__(self, settings, key):
        self.settings = settings
        self.key = key
        self.state = State(settings.state_dir)
        self.log_path = os.path.join(settings.log_dir, "sends.jsonl")
        self.started = time.time()
        self.started_at = iso_now()
        self.reconnects = 0
        self.connected = False
        self.connected_at = ""
        self.last_event = ""
        self.last_reason = ""
        # THE LAST STOP IS KEPT WHILE CONNECTED. `reason` is empty once the
        # listener is back, and a count with no cause beside it tells a person
        # nothing about why it grew.
        self.last_stop = ""
        self.last_stop_at = ""
        self.adapter_said = ""
        self.heard_listening = False
        self.probe_passed = False
        self.position = Position(settings.state_dir)
        self.route_lock = threading.Lock()
        self.passed = 0
        self.last_passed = ""
        self.last_passed_at = ""
        self.passed_window = -3600.0
        self.passed_logged = 0
        self.passed_quiet = 0
        self.stop = threading.Event()

    # -- inbound ------------------------------------------------------------
    def inbox_id(self):
        return (self.state.routes.get("self") or {}).get("inbox_id", "")

    def listen_forever(self):
        """One `listen` child, restarted with backoff for as long as we run.

        A dropped connection is ordinary. What is not ordinary is a service that
        looks healthy while it is reaching nothing, which is why `email status`
        reads connected or not connected rather than running or not running.
        """
        lo, hi = self.settings.reconnect_bounds()
        wait = lo
        while not self.stop.is_set():
            # NO KEY IS A NOT-YET, HELD ON THIS SAME LADDER. A person puts the
            # key in the claw's vault long after the service starts, so the
            # resolution is retried here rather than read once at start, and a
            # key that arrives is picked up without a restart. The reason names
            # no value: resolve_key raises with a sentence about the reference.
            if not self.key:
                try:
                    self.key = resolve_key()
                except Exception as exc:
                    self.connected = False
                    self.last_reason = ("no provider key is resolved yet: %s"
                                        % str(exc)[:200])
                    self.stop.wait(wait + random.uniform(0, wait * 0.25))
                    wait = min(hi, wait * 2)
                    continue
                log("info", "a provider key resolved, so the listener starts")
                wait = lo
            self.state.refresh_routes()
            inbox = self.inbox_id()
            if not inbox:
                self.connected = False
                # THE PROBE'S REFUSAL OUTRANKS THE MISSING INBOX. On the hub on
                # 2026-09-12 the key resolved and the provider answered 403,
                # while a member's status read "names no inbox yet". A member
                # who follows that sentence runs `email inbox create` and meets
                # the 403 there. So the service asks the same probe --check
                # asks, and holds its reason where status reads it. A refused
                # probe is asked again on the reconnect ladder.
                refusal = self.probe_refusal()
                if refusal:
                    self.last_reason = "the provider probe did not pass: %s" % refusal
                    self.stop.wait(wait + random.uniform(0, wait * 0.25))
                    wait = min(hi, wait * 2)
                    continue
                wait = lo
                self.last_reason = NO_INBOX_REASON
                self.stop.wait(10)
                continue
            if self.position.start(inbox):
                log("info", "no saved position for inbox %s, so mail is routed from %s on"
                    % (inbox, self.position.after))
            began = time.monotonic()
            self.heard_listening = False
            self.adapter_said = ""
            try:
                self.pump(inbox)
                # THE ADAPTER'S OWN WORDS. A failing adapter prints its cause
                # under `error` before it exits, and that is the reason.
                # The journal and `reason` say whose words follow. `last_stop`
                # holds the words alone.
                stop = self.adapter_said or "the listener exited and the adapter gave no reason"
                self.last_reason = ((ADAPTER_SAID + stop) if self.adapter_said else stop)
            except Exception as exc:
                stop = self.last_reason = clean(exc)
            self.connected = False
            if self.stop.is_set():
                return
            self.reconnects += 1
            self.last_stop = stop
            self.last_stop_at = iso_now()
            # A GOOD CONNECTION RESETS THE WAIT. The provider closes a live
            # connection in the ordinary course, and a wait that only grew
            # reached its cap after six such closes and stayed there, which left
            # the inbox unheard for a minute in every eleven. Backoff grows only
            # across connections that failed.
            if self.heard_listening or time.monotonic() - began > 60:
                wait = lo
            log("warn", "listener stopped (%s); reconnecting in about %ds" % (self.last_reason, wait))
            self.stop.wait(wait + random.uniform(0, wait * 0.25))
            wait = min(hi, wait * 2)

    def probe_refusal(self):
        """The probe's reason for not passing with the key this process holds.

        Empty once the probe has passed for this key. After that the listener
        is what reads the provider, and its own failure carries its own reason.
        """
        if self.probe_passed:
            return ""
        try:
            probe = run_adapter(self.settings, self.key, "probe", {}, timeout=30)
        except Exception as exc:
            return str(exc)[:300]
        if probe.get("ready"):
            self.probe_passed = True
            return ""
        return str(probe.get("reason") or "the probe gave no reason")[:300]

    def pump(self, inbox):
        path = self.settings.adapter_path()
        if not (os.path.isfile(path) and os.access(path, os.X_OK)):
            raise RuntimeError("no executable adapter at %s" % path)
        env = dict(os.environ)
        env[KEY_ENV] = self.key
        proc = subprocess.Popen([path, "listen"], stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                text=True, env=env)
        try:
            proc.stdin.write(json.dumps({"inbox_id": inbox}) + "\n")
            proc.stdin.flush()
            proc.stdin.close()
            for line in proc.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    evt = json.loads(line)
                except ValueError:
                    evt = None
                if not isinstance(evt, dict):
                    self.passed_over({"frame_type": "adapter-not-json", "size": len(line)})
                    continue
                if evt.get("event") == "listening":
                    self.connected = True
                    self.connected_at = iso_now()
                    self.heard_listening = True
                    log("info", "listening on inbox %s through the %s adapter"
                        % (inbox, self.settings.adapter))
                    if evt.get("inbox_confirmed") is False:
                        log("warn", "the provider confirmed a subscription that does not "
                                    "name inbox %s, so its mail may not arrive" % inbox)
                    # THE CATCH-UP RUNS HERE, ON THIS THREAD. Mail the push
                    # channel delivers meanwhile waits in the pipe, and the id
                    # list refuses whichever copy comes second.
                    self.catch_up(inbox)
                    continue
                if evt.get("event") == "received":
                    self.connected = True
                    self.fan_out(evt)
                    continue
                if evt.get("event") == "unrecognised":
                    self.passed_over(evt)
                    continue
                if evt.get("error"):
                    self.adapter_said = clean(evt["error"])
                    continue
                self.passed_over({"frame_type": "adapter-line", "keys": list(evt)})
        finally:
            self.connected = False
            try:
                proc.terminate()
                proc.wait(timeout=10)
            except Exception:
                pass

    def passed_over(self, evt):
        """A line or a frame nothing here acts on, logged and counted.

        THE DESCRIPTION CARRIES WORDS ONLY. The adapter already names no value,
        and this reads its report through word() again, so an adapter that
        slipped cannot put a sender or a subject in the journal. At most
        PASSED_OVER_PER_HOUR lines an hour reach the journal, so a chatty
        provider cannot fill it, and the count of the rest is logged when the
        hour turns.
        """
        keys = evt.get("keys") if isinstance(evt.get("keys"), list) else []
        named = sorted(k for k in keys if word(k))
        desc = "type %s, event type %s, keys %s, %s bytes" % (
            word(evt.get("frame_type")) or "unnamed",
            word(evt.get("event_type")) or "none",
            ",".join(named[:30]) or "none",
            evt.get("size") if isinstance(evt.get("size"), int) else "unknown")
        if len(named) < len(keys) or evt.get("unnamed_keys"):
            desc += ", and some keys that are not plain words"
        now = time.monotonic()
        with self.route_lock:
            self.passed += 1
            self.last_passed = desc
            self.last_passed_at = iso_now()
            if now - self.passed_window >= 3600:
                if self.passed_quiet:
                    log("warn", "%d more frames were passed over in the last hour and not logged"
                        % self.passed_quiet)
                self.passed_window, self.passed_logged, self.passed_quiet = now, 0, 0
            if self.passed_logged >= PASSED_OVER_PER_HOUR:
                self.passed_quiet += 1
                return
            self.passed_logged += 1
        log("warn", "the adapter passed over a frame it does not act on: %s. "
                    "%d passed over since the service started" % (desc, self.passed))

    def catch_up(self, inbox):
        """Every mail since the saved position, through the same fan-out.

        A failed listing is logged and asked again on the next connect. The
        connection it rode on stays up, because the push channel still works.
        """
        after = self.position.after
        try:
            out = run_adapter(self.settings, self.key, "list-since",
                              {"inbox_id": inbox, "after": after}, timeout=300)
        except Exception as exc:
            log("warn", "could not list the mail since %s, so the next connect asks again: %s"
                % (after, clean(exc)))
            return
        n = 0
        for evt in out.get("messages") or []:
            if isinstance(evt, dict) and self.fan_out(evt):
                n += 1
        if n:
            log("info", "routed %d mail that arrived while nobody listened, since %s" % (n, after))

    def fan_out(self, evt):
        """One inbound mail becomes one bus message per target handle.

        Returns False for a mail already routed, which is not routed again.
        """
        mid = evt.get("message_id", "")
        with self.route_lock:
            if self.position.seen(mid):
                return False
            self.route_one(evt)
            self.position.record(mid, evt.get("date", ""))
        return True

    def route_one(self, evt):
        self.last_event = iso_now()
        # A route added a moment ago reaches this mail. Same reading as the
        # command's, taken here because an inbound arrives on its own thread.
        self.state.refresh_routes()
        handles, why = self.state.route(evt.get("from", ""), evt.get("thread_id", ""))
        if not handles:
            log("warn", "a mail arrived and the table names nobody for it, not even a default")
            return
        subject = evt.get("subject") or "(no subject)"
        body = "from %s on %s. %s" % (
            evt.get("from", "an unknown sender"),
            evt.get("date", "an unknown date"),
            one_line(evt.get("preview", "")),
        )
        ref = "email:%s/%s" % (evt.get("thread_id", ""), evt.get("message_id", ""))
        for h in handles:
            try:
                bus_send(self.settings, h, subject, body, ref)
                log("info", "routed a mail to %s by %s" % (h, why))
            except Exception as exc:
                log("err", "could not put a mail on the bus for %s: %s" % (h, exc))

    # -- outbound -----------------------------------------------------------
    def do_send(self, req, peer):
        inbox = self.inbox_id()
        if not inbox:
            return {"ok": False, "reason": NO_INBOX_REASON}
        payload = {
            "inbox_id": inbox,
            "to": req.get("to") or [],
            "cc": req.get("cc") or [],
            "subject": req.get("subject") or "",
            "text": req.get("body") or "",
            "in_reply_to": req.get("in_reply_to") or "",
            "thread_id": req.get("thread") or "",
        }
        out = run_adapter(self.settings, self.key, "send", payload)
        thread_id = out.get("thread_id") or payload["thread_id"]
        handle = req.get("handle") or ""
        if thread_id and handle:
            self.state.remember_thread(thread_id, handle)
        self.record_send(req, peer, out)
        return {"ok": True, "message_id": out.get("message_id", ""), "thread_id": thread_id}

    def record_send(self, req, peer, out):
        """The audit line.

        `uid` is measured from the socket peer and cannot be chosen. `handle` is
        typed by the caller and cannot be checked. Both are recorded and the
        record says which is which, the same way the bus records `from` beside
        `sender`. No message body is written here.
        """
        append_json(self.log_path, {
            "ts": iso_now(),
            "peer_uid": peer.get("uid"),
            "peer_user": peer.get("user"),
            "claimed_handle": req.get("handle") or "",
            "to": req.get("to") or [],
            "cc": req.get("cc") or [],
            "subject": req.get("subject") or "",
            "in_reply_to": req.get("in_reply_to") or "",
            "message_id": out.get("message_id", ""),
            "thread_id": out.get("thread_id", ""),
        })

    # -- the socket ---------------------------------------------------------
    def handle_request(self, req, peer):
        # THE FILE IS THE RECORD. Every command reads the table as it is on
        # disk, so an answer never comes out of a copy the process took at
        # start and a hand edit is honoured without a restart.
        self.state.refresh_routes()
        verb = req.get("verb", "")
        if verb == "status":
            return {
                "ok": True,
                "adapter": self.settings.adapter,
                "inbox_id": self.inbox_id(),
                "address": (self.state.routes.get("self") or {}).get("address", ""),
                "connected": self.connected,
                "uptime_secs": int(time.time() - self.started),
                "reconnects": self.reconnects,
                "reconnects_since": self.started_at,
                "last_event": self.last_event,
                "reason": "" if self.connected else self.last_reason,
                "last_stop": self.last_stop,
                "last_stop_at": self.last_stop_at,
                "caught_up_from": self.position.after,
                "passed_over": self.passed,
                "last_passed_over": self.last_passed,
                "last_passed_over_at": self.last_passed_at,
                "health": self.health_words(),
                "threads_known": len(self.state.threads),
            }
        if verb == "send":
            return self.do_send(req, peer)
        if verb == "thread":
            return {"ok": True, "thread": run_adapter(
                self.settings, self.key, "thread",
                {"inbox_id": self.inbox_id(), "thread_id": req.get("id", "")})}
        if verb == "message":
            return {"ok": True, "message": run_adapter(
                self.settings, self.key, "message",
                {"inbox_id": self.inbox_id(), "message_id": req.get("id", "")})}
        if verb == "route-list":
            return {"ok": True, "routes": self.state.routes}
        if verb == "route-add":
            return self.route_add(req)
        if verb == "route-remove":
            return self.route_remove(req)
        if verb == "inbox-create":
            return self.inbox_create(req)
        if verb == "self-set-runbook":
            return self.self_set_runbook(req)
        if verb == "self-clear-runbook":
            return self.self_clear_runbook(req)
        return {"ok": False, "reason": "no such verb: %s" % verb}

    def health_words(self):
        """The connection, the reconnect count and the last stop, in words.

        A person reads this line. A growing count is ordinary, because the
        provider closes a live connection now and then, so the line says what
        the last stop was and leaves the judgement to the reader.
        """
        if self.connected:
            head = "Connected since %s." % self.connected_at
        else:
            why = self.last_reason
            if why.startswith(ADAPTER_SAID):
                why = why[len(ADAPTER_SAID):]
            head = "Not connected. %s" % sentences(why or "the listener has not started", True)
        if not self.reconnects:
            tail = "No reconnect since the service started at %s." % self.started_at
        else:
            tail = "Reconnected %s since %s. The last stop was at %s: %s" % (
                times(self.reconnects), self.started_at, self.last_stop_at,
                sentences(self.last_stop, False))
        words = "%s %s" % (head, tail)
        if self.passed:
            words += " %s passed over, the last at %s: %s." % (
                "1 frame was" if self.passed == 1 else "%d frames were" % self.passed,
                self.last_passed_at, self.last_passed)
        return clean(words, 1000)

    def route_add(self, req):
        key = (req.get("key") or "").strip().lower()
        handle = (req.get("handle") or "").strip()
        if not key or not handle:
            return {"ok": False, "reason": "a route needs a sender domain or address and a handle"}
        with self.state.lock:
            bucket = "addresses" if "@" in key else "domains"
            if bucket == "domains":
                have = self.state.routes["domains"].setdefault(key, [])
                if handle not in have:
                    have.append(handle)
            else:
                entry = self.state.routes["addresses"].setdefault(
                    key, {"handles": [], "agent": bool(req.get("agent"))})
                if handle not in entry["handles"]:
                    entry["handles"].append(handle)
                if req.get("agent") is not None:
                    entry["agent"] = bool(req.get("agent"))
            self.state.save_routes()
        return {"ok": True, "routes": self.state.routes}

    def route_remove(self, req):
        key = (req.get("key") or "").strip().lower()
        handle = (req.get("handle") or "").strip()
        with self.state.lock:
            bucket = "addresses" if "@" in key else "domains"
            if bucket == "domains":
                have = self.state.routes["domains"].get(key, [])
                if handle:
                    self.state.routes["domains"][key] = [h for h in have if h != handle]
                    if not self.state.routes["domains"][key]:
                        self.state.routes["domains"].pop(key, None)
                else:
                    self.state.routes["domains"].pop(key, None)
            else:
                entry = self.state.routes["addresses"].get(key)
                if entry and handle:
                    entry["handles"] = [h for h in entry["handles"] if h != handle]
                    if not entry["handles"]:
                        self.state.routes["addresses"].pop(key, None)
                else:
                    self.state.routes["addresses"].pop(key, None)
            self.state.save_routes()
        return {"ok": True, "routes": self.state.routes}

    def self_set_runbook(self, req):
        """Where the firm's communication runbook rests, recorded once.

        WHAT THIS SERVICE CHECKS, AND WHAT IT CANNOT. An absolute path is the
        only shape this value can take, and that is a reading of the string, so
        it is made here. Whether the file exists is a reading of the caller's
        own directory. This service runs as its own system account and a firm's
        workspace is group-owned with nothing granted to everybody else, so a
        stat taken here would refuse a path that is there. The command takes
        that reading, standing where the caller stands.

        The value is a pointer and never the document. Nothing in this service
        opens it: which mail waits for a person is the email orchestrator's
        runbook, and this records only where that agent put it.
        """
        path = (req.get("path") or "").strip()
        if not path:
            return {"ok": False, "reason": "a runbook needs a path"}
        if not path.startswith("/"):
            return {"ok": False, "reason":
                    "%s is a relative path. The runbook is recorded as an absolute path, "
                    "because the session that reads this table does not stand where the "
                    "session that wrote it stood." % path}
        with self.state.lock:
            self.state.routes.setdefault("self", {})["runbook"] = path
            self.state.save_routes()
        return {"ok": True, "self": self.state.routes["self"]}

    def self_clear_runbook(self, req):
        """The recorded runbook path, returned to empty.

        A FIELD A COMMAND CAN SET IS A FIELD A COMMAND CAN UNSET. Without this
        the only road back to the seeded state was an edit by hand, and an
        empty argument to `self set` stays refused, because a caller who meant
        to clear says so and a caller whose variable was empty did not.
        """
        with self.state.lock:
            self.state.routes.setdefault("self", {})["runbook"] = ""
            self.state.save_routes()
        return {"ok": True, "self": self.state.routes["self"]}

    def inbox_create(self, req):
        """The claw's own address, made once, by a person, after the key is wired.

        REFUSED WHEN `self` IS ALREADY SET. A second inbox is a second identity
        on the same claw, and the address is in every From: line a recipient
        ever sees. Changing it later means telling everybody who has one.
        """
        cur = self.state.routes.get("self") or {}
        # A CREATE NAMES ITS INBOX. The provider picks a name when it is given
        # none, and the service would record that name and listen on it. The
        # command refuses first and every adapter refuses after, and this
        # refusal covers a caller on the socket and an adapter that does not.
        if not (req.get("username") or "").strip():
            return {"ok": False, "reason":
                    "an inbox create needs a username, so nothing was asked of the provider"}
        if cur.get("inbox_id"):
            return {"ok": False, "reason":
                    "this claw already has an inbox: %s. Editing routes.json by hand is the "
                    "deliberate way to change it, and this service re-reads the file, so the "
                    "edit reaches it without a restart." % cur.get("address", cur["inbox_id"])}
        out = run_adapter(self.settings, self.key, "make-inbox", {
            "username": req.get("username") or "",
            "domain": req.get("domain") or "",
            "display_name": req.get("display_name") or "",
        })
        with self.state.lock:
            # THE RUNBOOK CARRIES OVER. An operator may record it before the
            # key is wired, and this block writes `self` whole.
            self.state.routes["self"] = {
                "address": out.get("address", ""),
                "display_name": req.get("display_name") or "",
                "inbox_id": out.get("inbox_id", ""),
                "runbook": cur.get("runbook", ""),
            }
            self.state.save_routes()
        return {"ok": True, "self": self.state.routes["self"]}

    def serve_socket(self):
        path = self.settings.socket
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
        except OSError:
            pass
        try:
            os.unlink(path)
        except OSError as exc:
            if exc.errno != errno.ENOENT:
                raise
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(path)
        # 0660 with the members group. Unix permissions are the whole access
        # story here, which is what a connection service is.
        try:
            import grp
            os.chown(path, -1, grp.getgrnam(self.settings.socket_group).gr_gid)
        except (KeyError, OSError) as exc:
            log("warn", "could not set the socket group to %s: %s"
                % (self.settings.socket_group, exc))
        os.chmod(path, 0o660)
        srv.listen(16)
        log("info", "listening on %s" % path)
        while not self.stop.is_set():
            try:
                conn, _ = srv.accept()
            except OSError:
                continue
            threading.Thread(target=self.serve_one, args=(conn,), daemon=True).start()

    def serve_one(self, conn):
        peer = {"uid": None, "user": "?"}
        try:
            # SO_PEERCRED is measured by the kernel. A caller cannot choose it.
            raw = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                                  struct.calcsize("3i"))
            _pid, uid, _gid = struct.unpack("3i", raw)
            peer["uid"] = uid
            try:
                peer["user"] = pwd.getpwuid(uid).pw_name
            except KeyError:
                peer["user"] = str(uid)
        except OSError:
            pass
        try:
            conn.settimeout(120)
            data = b""
            while b"\n" not in data:
                chunk = conn.recv(65536)
                if not chunk:
                    break
                data += chunk
                if len(data) > 8 * 1024 * 1024:
                    break
            req = json.loads(data.decode("utf-8", "replace").strip() or "{}")
            try:
                resp = self.handle_request(req, peer)
            except Exception as exc:
                resp = {"ok": False, "reason": str(exc)[:400]}
            conn.sendall((json.dumps(resp) + "\n").encode("utf-8"))
        except Exception as exc:
            log("warn", "a socket request failed: %s" % str(exc)[:200])
        finally:
            try:
                conn.close()
            except OSError:
                pass


# ---------------------------------------------------------------------- checks
def cmd_check(settings):
    """Resolve everything, probe the adapter, connect to nothing."""
    report = {
        "conf": CONF,
        "enabled": settings.enabled(),
        "adapter": settings.adapter,
        "adapter_path": settings.adapter_path(),
        "state_dir": settings.state_dir,
        "log_dir": settings.log_dir,
        "socket": settings.socket,
        "bus_cli": settings.bus_cli,
        "bus_dir": settings.bus_dir or "(the CLI's own default)",
        "origin": settings.origin,
    }
    st = State(settings.state_dir)
    report["inbox_id"] = (st.routes.get("self") or {}).get("inbox_id", "")
    report["address"] = (st.routes.get("self") or {}).get("address", "")
    report["default_handle"] = st.routes.get("default", "")
    report["runbook"] = (st.routes.get("self") or {}).get("runbook", "")

    key = ""
    try:
        key = resolve_key()
        # WHERE IT CAME FROM, not what it is. A claw reading "environment" here
        # is a claw whose key is not coming from its vault, and that is worth
        # seeing in a health line.
        report["key"] = "resolved from the environment" if os.environ.get(KEY_ENV) \
            else "resolved through %s" % ENVFILE
    except Exception as exc:
        report["key"] = "not resolved: %s" % exc

    try:
        probe = run_adapter(settings, key, "probe", {}, timeout=30)
        report["probe"] = probe
    except Exception as exc:
        report["probe"] = {"ready": False, "reason": str(exc)}
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report.get("probe", {}).get("ready") else 3


def cmd_serve(settings):
    if not settings.enabled():
        log("info", "ENABLED is not yes in %s, so this service is deliberately off" % CONF)
        return 0
    for d in (settings.state_dir, settings.log_dir):
        os.makedirs(d, exist_ok=True)
    # A CLAW WITH NO KEY IS THE ORDINARY STATE OF A FRESH CLAW, not a failure.
    # The socket opens either way, so `email status` answers and phase 25 reads
    # its health line. The listener starts only when a key resolves, and the
    # resolution is retried on the same ladder a dropped connection uses,
    # because the thing that changes is a person putting the key in the vault.
    key = ""
    try:
        key = resolve_key()
    except Exception as exc:
        log("info", "no provider key is resolved yet, so no mail is routed: %s. "
                    "A person wires one with install-email-provider-key.sh" % exc)
    gk = Gatekeeper(settings, key)
    gk.state.compact_threads()
    threading.Thread(target=gk.listen_forever, daemon=True).start()
    try:
        gk.serve_socket()
    except KeyboardInterrupt:
        pass
    finally:
        gk.stop.set()
    return 0


def main():
    ap = argparse.ArgumentParser(add_help=True, description=__doc__.splitlines()[0])
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--check", action="store_true", help="resolve and probe, serve nothing")
    g.add_argument("--serve", action="store_true", help="run the service")
    a = ap.parse_args()
    try:
        syslog.openlog(LOG_TAG, syslog.LOG_PID, syslog.LOG_DAEMON)
    except Exception:
        pass
    settings = Settings()
    return cmd_check(settings) if a.check else cmd_serve(settings)


if __name__ == "__main__":
    sys.exit(main())
