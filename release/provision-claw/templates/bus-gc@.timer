# Installed VERBATIM, never rendered. See bus-gc@.service.
#
# Once a day, in the small hours, spread over an hour so the accounts on one
# claw do not all take the handle lock together. Persistent, so a claw that was
# off at that hour runs it at the next boot.
[Unit]
Description=Bus gc for %i, once a day

[Timer]
OnCalendar=*-*-* 03:40:00
RandomizedDelaySec=1h
Persistent=true
Unit=bus-gc@%i.service

[Install]
WantedBy=timers.target
