# Installed VERBATIM, never rendered. See commonclaw-memory-check.service.
[Unit]
Description=Firm-VM memory check, every five minutes

[Timer]
# FIVE MINUTES, and the number is derived rather than picked. Two things read
# it. The alarm's worst case is one interval between a line being crossed and
# the channel hearing about it; the box that started this rail was unreachable
# for half an hour, so five minutes is the difference between a warning and a
# post-mortem. The dead-man check's grace period is derived from the same
# number: ten minutes off the box tolerates one missed beat and alarms on two.
OnCalendar=*-*-* *:0/5:00
# NO RandomizedDelaySec, and the absence is deliberate. Every other timer here
# jitters to spread load. This one is the source of a heartbeat, and jitter only
# widens the largest gap the off-box grace period has to cover.
Persistent=true

[Install]
WantedBy=timers.target
