# RENDERED once per connection by scripts/install-connection.sh, beside the
# service of the same name. The group is SOCKET_GROUP from the connection's
# conf, read at each apply.
#
# WHY A SOCKET UNIT. The socket's group is who may call the service, and the
# default group is the claw's people. A service account is never a member of a
# people group, so a socket the service bound for itself could not be given
# that group. systemd makes the socket as root with the group already set, and
# hands it to the service when the service starts. The directory is made by
# systemd too, and the socket is removed when this unit stops.
[Unit]
Description=Socket for connection service {{NAME}}

[Socket]
ListenStream=/run/commonclaw-conn-{{NAME}}/sock
SocketUser=svc-{{NAME}}
SocketGroup={{SOCKET_GROUP}}
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes
Accept=no

[Install]
WantedBy=sockets.target
